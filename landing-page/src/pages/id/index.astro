---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dictionary } from '../../data/locales/id';
import { Navbar } from '../../components/Navbar';
import { Hero } from '../../components/Hero';
import { Footer } from '../../components/Footer';
import { FaqAccordion } from '../../islands/FaqAccordion';
---
<BaseLayout meta={dictionary.meta} locale="id">
  <script is:inline>
    (function () {
      try {
        localStorage.setItem('9drive_locale', 'id');
      } catch (e) {
        // Suppress SecurityError, QuotaExceededError, or private browsing exceptions
      }
    })();
  </script>
  <Navbar client:load nav={dictionary.nav} currentLocale="id" />
  <main>
    <Hero hero={dictionary.hero} />
    <section id="faq" class="faq-section">
      <h2 class="faq-section-title">{dictionary.faq.sectionTitle}</h2>
      <p class="faq-section-subtitle">{dictionary.faq.sectionSubtitle}</p>
      <FaqAccordion client:visible items={dictionary.faq.items} />
    </section>
  </main>
  <Footer footer={dictionary.footer} />
</BaseLayout>
