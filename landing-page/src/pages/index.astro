---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dictionary } from '../data/locales/en';
---
<BaseLayout meta={dictionary.meta} locale="en">
  <script is:inline>
    (function () {
      try {
        var stored = null;
        try {
          stored = localStorage.getItem('9drive_locale');
        } catch (e) {
          // Storage access restricted (e.g. private browsing or SecurityError)
        }
        var target = (stored === 'id' || stored === 'en')
          ? stored
          : ((navigator.language && navigator.language.toLowerCase().indexOf('id') === 0) ? 'id' : 'en');
        var search = window.location.search || '';
        var hash = window.location.hash || '';
        window.location.replace('/' + target + search + hash);
      } catch (e) {
        window.location.replace('/en' + (window.location.search || '') + (window.location.hash || ''));
      }
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/en" />
  </noscript>
</BaseLayout>
