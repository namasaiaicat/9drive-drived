---
import HeadMeta from '../components/HeadMeta.astro';
import type { PageMetadata, Locale } from '../types';
import themeInitScript from '../scripts/theme-init.inline.js?raw';
import '../styles/theme.css';

interface Props {
  meta: PageMetadata;
  locale: Locale;
}

const { meta, locale } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline set:html={themeInitScript} />
    <HeadMeta meta={meta} locale={locale} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
